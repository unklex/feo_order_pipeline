# ---------------------------------------------------------------------------
# Секреты и сессии — никогда не коммитить
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
gisopvk_webapi_cookies.json

# ---------------------------------------------------------------------------
# Локальные данные: выгрузки ФГИС, распарсенные заявки, отчёты, проверки
# ---------------------------------------------------------------------------
gisopvk_webapi_*.jsonl.gz
gisopvk_webapi_*_stats.json
gisopvk_webapi_progress.txt
*.partial
# распарсенные заявки (пишет 1_step0_2.1_collects_bids.py в папку проекта)
batch_*.json
parsed_data_*.json
# отработанные файлы (pipeline.py / fill db.py), чистятся через ARCHIVE_KEEP_DAYS
archive/
parsed_bids/
opvk-export*/
opvk-export*.zip
chk_*/
# телеметрия (telemetry_download.py): точки ТС, десятки ГБ
telemetry/
export/
progress/
reports/
# отчёт fill db.py о созданных в Битрикс компаниях
bitrix_companies_imported.xlsx
*.xlsx
*.csv

# ---------------------------------------------------------------------------
# Логи (в т.ч. JSONL-журналы audit_*.jsonl с данными заказов)
# ---------------------------------------------------------------------------
logs/
*.log

# ---------------------------------------------------------------------------
# Jupyter-ноутбуки — разовые разборы, в репозиторий не входят
# ---------------------------------------------------------------------------
*.ipynb
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Python / окружение
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---------------------------------------------------------------------------
# IDE / ОС
# ---------------------------------------------------------------------------
.idea/
.vscode/
.claude/
Thumbs.db
.DS_Store
