# ---------------------------------------------------------------------------
# Пример конфигурации. Скопируйте в .env и заполните реальными значениями:
#     cp .env.example .env
# Файл .env НЕ коммитить в репозиторий (добавьте его в .gitignore).
# ---------------------------------------------------------------------------

# --- Режим подключения к БД ---
# 1 (по умолчанию) — через SSH-туннель (переменные SSH_* ниже, DB_HOST — адрес БД относительно SSH-хоста).
# 0 — напрямую из внутренней сети: DB_HOST/DB_PORT — реальный адрес сервера БД,
#     SSH_* и SSH_ALT_* не нужны, пакеты sshtunnel/paramiko можно не устанавливать.
DB_USE_SSH=1

# --- SSH туннель ---
SSH_HOST=77.244.66.47
SSH_PORT=2277
SSH_USERNAME=root
SSH_PASSWORD=
# Вход по ключу вместо пароля (необязательно, приоритетнее SSH_PASSWORD):
# SSH_KEY_PATH=C:\Users\user\.ssh\id_ed25519
# SSH_KEY_PASSPHRASE=

# --- Второй SSH-шлюз (update_orders_daily.py, debug_update.py) ---
SSH_ALT_HOST=185.47.206.67
SSH_ALT_PORT=2277
SSH_ALT_USERNAME=tunnel
SSH_ALT_PASSWORD=

# --- База данных MySQL (при DB_USE_SSH=1 — адрес относительно SSH-хоста, при 0 — адрес в сети) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fgis_feo
DB_USER=a.bugrov
DB_PASSWORD=

# --- Параметры Битрикс24 ---
# ID смарт-процесса ФЭО
BITRIX_ENTITY_TYPE_ID=137
# Максимум одновременных запросов к API
BITRIX_MAX_CONCURRENT=20

# --- Битрикс24 webhook (секрет, раньше был зашит в bitrix_config.py) ---
BITRIX_WEBHOOK_URL=https://bx24.promreo.ru/rest/<user>/<token>/
# Необязательно: внешние папки с общими модулями (bitrix_config / db_connection / bx24 / tg_bot)
# BITRIX_LIB_DIR=
# WORK_DIR=
